{
  "name": "task-manager",
  "version": "1.0.0",
  "description": "Task tracking and collaboration backend (Node.js + TypeScript + Express + PostgreSQL)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "migrate": "node dist/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "dev": "tsx src/index.ts",
    "test": "cross-env LLM_PROVIDER=mock vitest run"
  },
  "dependencies": {
    "bcrypt": "5.1.1",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "pg": "8.12.0",
    "socket.io": "4.7.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/multer": "1.4.11",
    "@types/node": "20.14.9",
    "@types/pg": "8.11.6",
    "@types/supertest": "6.0.2",
    "cross-env": "7.0.3",
    "supertest": "7.0.0",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "1.6.0"
  }
}
