# Postgres connection string (required)
DATABASE_URL=postgres://taskmgr:taskmgr@localhost:5432/task_manager

# HMAC secret for signing JWTs (required, min length 16)
JWT_SECRET=change-me-to-a-long-random-secret

# HTTP port (default 3000)
PORT=3000

# AI provider: mock (default, offline/deterministic) or ollama
LLM_PROVIDER=mock

# Ollama base URL (used only when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434

# Ollama model name (used only when LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.1:8b

# Local directory for uploaded files (gitignored)
UPLOAD_DIR=uploads

# Maximum upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# Node environment: development | test | production
NODE_ENV=development
